# RAKSHAK Environment Variables
# Copy this file to .env and fill in your values

# IMD (India Meteorological Department) API
# Optional - RAKSHAK works without this using Open-Meteo
# To enable IMD integration, you need API credentials from IMD
VITE_IMD_API_KEY=
VITE_IMD_API_URL=

# Note: Open-Meteo API is free and requires no API key
# It provides weather, precipitation, and elevation data globally
# Documentation: https://open-meteo.com/en/docs

# Browser Geolocation API is built into modern browsers
# No configuration needed - users must grant permission
